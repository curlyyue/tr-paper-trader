# --- TR Paper Trader configuration ---

# Claude model. CLI aliases: opus | sonnet | haiku
# (mapped to claude-opus-4-8 / claude-sonnet-5 / claude-haiku-4-5 when using the API backend;
#  full API ids are also accepted here)
TRADER_MODEL=opus

# Ledger/agent name. Defaults to the model name, so each model keeps its own
# portfolio in data/<agent>.db — run once with TRADER_MODEL=opus and once with
# TRADER_MODEL=haiku and you get two independent books to compare.
# Set this explicitly only if you want e.g. two experiments on the same model.
#TRADER_AGENT=opus

# LLM backend:
#   cli = `claude -p` under your Claude Pro/Max subscription (default, no key needed)
#   api = Anthropic API (requires ANTHROPIC_API_KEY below)
TRADER_BACKEND=cli

#ANTHROPIC_API_KEY=sk-ant-...

# Path to the claude CLI binary. Usually auto-detected (PATH, standalone
# installs, or the binary bundled inside the Claude desktop app).
#CLAUDE_BIN=
